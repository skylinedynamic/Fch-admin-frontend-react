# Copy to .env.e2e (git-ignored).
# The mocked specs (npm run test:e2e) need none of this.

# Live specs (npm run test:e2e:live): the API the served build talks to. It must
# match the VITE_API_URL the app was built with.
E2E_API_URL=http://127.0.0.1:8000/api/v1

# The host account the live specs sign in as (local fch_dev: craig.rice@fourcornerfunding.com).
E2E_HOST_EMAIL=
E2E_HOST_PASSWORD=

# Optional: test an app that is already being served (for example the dev
# server) instead of the local preview build on :4174.
# E2E_BASE_URL=http://localhost:5174
