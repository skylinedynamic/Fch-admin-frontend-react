# Copy to .env.e2e (git-ignored) to configure the LIVE e2e suite.
# The mocked suite (npm run test:e2e) needs none of this.

# The API the served build talks to. It must match the VITE_API_URL the app
# was built with - the live suite checks this at login and tells you if not.
E2E_API_URL=http://127.0.0.1:8000/api/v1

# One account per persona. Any persona left blank is skipped, not failed.
# The host account is also the default session for the smoke/contract/CRUD specs.
E2E_HOST_EMAIL=
E2E_HOST_PASSWORD=
E2E_WL_PARTNER_EMAIL=
E2E_WL_PARTNER_PASSWORD=
E2E_CERTIFIED_PARTNER_EMAIL=
E2E_CERTIFIED_PARTNER_PASSWORD=
E2E_HOST_USER_EMAIL=
E2E_HOST_USER_PASSWORD=
E2E_WL_USER_EMAIL=
E2E_WL_USER_PASSWORD=
E2E_CERTIFIED_USER_EMAIL=
E2E_CERTIFIED_USER_PASSWORD=

# Specs that create/update/delete records only run when this is 1.
# Turn it on ONLY against a disposable database (never stage or production).
E2E_LIVE_ALLOW_WRITES=0

# Optional: test an app that is already being served instead of the local
# preview build (for example a stage URL).
# E2E_BASE_URL=https://admin.stage.example.com

# How long to wait for a screen's data. Raise it for a slow single-threaded dev server.
# E2E_LIVE_TIMEOUT_MS=60000
