VITE_API_URL = http://127.0.0.1:8000/api/v1
VITE_BASE_API_URL = http://127.0.0.1:8000
# The public website. Its host follows a partner's subdomain, so keep it in step
# with BASE_WEBSITE in fch-api.
VITE_WEBSITE_URL = http://localhost:3000/
# Laravel Reverb (real-time notifications). Leave the key empty to disable;
# the bell then refreshes by polling.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
